# 复制为 .env 后按需修改。系统环境变量优先，.env 不会覆盖已存在的同名变量。

# ---------- AI 适配层 ----------
# rule = 离线规则（默认，不联网、不花钱）；openai = 任意 OpenAI 兼容端点
AI_PROVIDER=rule

# 密钥只保存在服务端，不会下发给浏览器。留空时即使 PROVIDER=openai 也会自动降级为 rule
AI_API_KEY=
# 兼容端点地址（不带 /v1）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 允许调用的模型域名白名单，逗号分隔
AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,open.bigmodel.cn

# 单次调用超时（毫秒）
AI_TIMEOUT_MS=20000
# 同时进行的模型任务上限
AI_CONCURRENCY=2
# 每日任务预算，超出后只走规则模式
AI_MAX_DAILY_TASKS=200
# 是否在 schema 上下文中携带少量样例行（0 = 不发送任何数据值）
AI_SAMPLES=1
# 数据保存后是否自动生成洞察（0 = 只在手动点击时生成）
AI_AUTO_INSIGHT=1
AI_INSIGHT_COOLDOWN_MS=30000
AI_MAINTENANCE_COOLDOWN_MS=60000

# ---------- 服务 ----------
PORT=3000
HOST=127.0.0.1
# 监听非回环地址时必须同时配置口令与 Host 白名单
ACCESS_TOKEN=
ALLOWED_HOSTS=

# ---------- 数据源 ----------
# 换表只需改这两项后重启：TARGET_FILE 指向要监听的那个 Excel 文件。
# TARGET_FILE 留空时默认监听 DATA_DIR/sales.xlsx（DATA_DIR 默认项目下的 data/）。
# 换到结构不同的表之后，请在页面点「恢复默认布局」，否则旧图会报"列不存在"。
# 想直接覆盖数据而不改配置：把新内容另存为当前被监听的那个文件名即可，服务自动刷新。
DATA_DIR=
TARGET_FILE=
# 数据源模式：merged = 合并所有（可见）工作表并追加「工作表」列，便于分表对比；sheet = 只看一张表。
# 页面顶部下拉可随时切换，无需改这里；这里只决定启动时的默认值。
SOURCE_MODE=merged
# 画布配置持久化文件，默认位于数据目录下的 document.json
DOCUMENT_FILE=

# ---------- 解析上限 ----------
MAX_FILE_BYTES=26214400
MAX_ROWS=100000
MAX_COLUMNS=100
MAX_CELLS=2000000
# 合并视图上限：工作簿最多多少张表、合并后最多多少行
MAX_SHEETS=50
MAX_WORKBOOK_ROWS=200000
SKIP_TOTAL_ROWS=1
