est", "to": "snapshot", "label": "行 + 列元数据", "classification": "不可变快照", "variant": "emphasis", "route": "straight"}, {"from": "patch", "to": "doc", "label": "新 revision", "classification": "持久化", "variant": "emphasis", "route": "straight"}, {"from": "aiadapter", "to": "doc", "label": "建议 patch", "classification": "校验后应用", "variant": "dashed", "route": "auto"}, {"from": "snapshot", "to": "canvas", "label": "组件 props", "classification": "按需拉取", "variant": "dashed", "route": "auto"}, {"from": "doc", "to": "sse", "label": "变更广播", "classification": "版本号", "variant": "emphasis", "route": "vertical-channel"}, {"from": "sse", "to": "canvas", "label": "update 事件", "classification": "推送", "variant": "emphasis", "route": "auto"}]}